{
  "name": "ariadne",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "start": "pnpm --filter @ariadne/web start",
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "perf": "pnpm -r --workspace-concurrency=1 --if-present run perf",
    "test:ci": "pnpm -r --if-present run test:ci",
    "lint": "eslint . && pnpm typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "angular-eslint": "^22.6.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
