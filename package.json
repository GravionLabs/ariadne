{
  "name": "ariadne",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "start": "pnpm --filter @ariadne/web start",
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "perf": "pnpm -r --workspace-concurrency=1 --if-present run perf",
    "test:ci": "pnpm -r --if-present run test:ci",
    "lint": "oxlint && eslint \"**/*.html\" && node lint-probe/check.mjs && pnpm typecheck",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "22.6.0",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.15.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
