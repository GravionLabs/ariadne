{
  "name": "ariadne",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "start": "pnpm --filter @ariadne/web start",
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "test:ci": "pnpm -r --if-present run test:ci",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "angular-eslint": "^22.5.0",
    "eslint": "^10.11.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0"
  }
}
