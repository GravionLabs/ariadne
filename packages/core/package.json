{
  "name": "@ariadne/core",
  "version": "0.0.0",
  "private": true,
  "description": "The Ariadne domain: diagram model, YAML format, validation, layout, message catalog and walkthrough. No framework.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "perf": "vitest run --config vitest.perf.config.ts",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile.junit=../../test-results/junit-core.xml"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "fast-check": "^4.10.2",
    "vitest": "^5.0.0"
  }
}
