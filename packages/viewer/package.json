{
  "name": "@ariadne/viewer",
  "version": "0.0.0",
  "private": true,
  "description": "An embeddable, read-only viewer for saga diagrams: the <ariadne-saga> custom element.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./angular": "./angular/src/index.ts"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile.junit=../../test-results/junit-viewer.xml"
  },
  "dependencies": {
    "@ariadne/core": "workspace:*",
    "@ariadne/export": "workspace:*"
  },
  "devDependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@angular/common": ">=21.0.0 <23.0.0",
    "@angular/core": ">=21.0.0 <23.0.0",
    "rxjs": "^7.8.0"
  },
  "peerDependenciesMeta": {
    "@angular/common": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  }
}
