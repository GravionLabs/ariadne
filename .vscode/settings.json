{
  // oxfmt formats on save with the root .oxfmtrc.json (pnpm format does the same from the command line).
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  // The oxc extension also lints .ts/.js with .oxlintrc.json; ESLint lints only the templates.
  "oxc.enable": true,
  "eslint.validate": ["html"],
  // The .NET part has its own formatter (dotnet format, see CONTRIBUTING.md).
  "[csharp]": { "editor.defaultFormatter": "ms-dotnettools.csharp" }
}
