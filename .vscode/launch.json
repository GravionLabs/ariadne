{
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ng serve (Chrome)",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "pnpm: start",
      "url": "http://localhost:4200/",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "ng serve (Edge)",
      "type": "msedge",
      "request": "launch",
      "preLaunchTask": "pnpm: start",
      "url": "http://localhost:4200/",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Attach to Chrome (:9222)",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "url": "http://localhost:4200/*",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "ariadne diff (CLI)",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "pnpm: build cli",
      "program": "${workspaceFolder}/apps/cli/dist/ariadne.mjs",
      "args": [
        "diff",
        "samples/sagas/order/OrderStateMachine.saga.yaml",
        "samples/sagas/order/OrderStateMachine.cs"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "preLaunchTask": "pnpm: build vscode",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode",
        "${workspaceFolder}/samples"
      ],
      "outFiles": ["${workspaceFolder}/apps/vscode/dist/**/*.js"]
    },
    {
      "name": "Attach to Extension Host",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "outFiles": ["${workspaceFolder}/apps/vscode/dist/**/*.js"]
    },
    {
      "name": "ng test (Vitest)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["ng", "test", "--no-watch"],
      "cwd": "${workspaceFolder}/apps/web",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    }
  ]
}
