{
  // For more information, visit: https://go.microsoft.com/fwlink/?LinkId=733558
  "version": "2.0.0",
  "tasks": [
    {
      "label": "pnpm: start",
      "type": "shell",
      "command": "pnpm start",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected|Component update sent"
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)|Watch mode enabled"
          }
        }
      }
    },
    {
      "label": "pnpm: build",
      "type": "shell",
      "command": "pnpm build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$tsc"
    },
    {
      "label": "pnpm: test",
      "type": "shell",
      "command": "pnpm test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$tsc"
    },
    {
      "label": "pnpm: build cli",
      "type": "shell",
      "command": "pnpm --filter @ariadne/cli build",
      "problemMatcher": []
    },
    {
      "label": "pnpm: build vscode",
      "type": "shell",
      "command": "pnpm --filter ariadne-vscode build",
      "problemMatcher": []
    },
    {
      "label": "pnpm: dev vscode",
      "type": "shell",
      "command": "pnpm --filter ariadne-vscode dev",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "pnpm: lint",
      "type": "shell",
      "command": "pnpm lint",
      "problemMatcher": "$eslint-stylish"
    }
  ]
}
