{
  "name": "@ariadne/viewer-demo",
  "version": "0.0.0",
  "private": true,
  "description": "A small Angular app that uses @ariadne/viewer/angular; it also runs the specs of the wrapper.",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/copy-sample.mjs",
    "start": "ng serve",
    "prebuild": "node scripts/copy-sample.mjs",
    "build": "ng build",
    "test": "ng test --no-watch",
    "test:ci": "ng test --no-watch --configuration=ci"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@ariadne/core": "workspace:*",
    "@ariadne/export": "workspace:*",
    "@ariadne/viewer": "workspace:*",
    "@dagrejs/dagre": "^3.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "jsdom": "^30.0.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
