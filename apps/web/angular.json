{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "ariadne": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "loader": { ".yaml": "text", ".cs": "text", ".wasm": "binary" },
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "tree-sitter-c_sharp.wasm",
                "input": "node_modules/tree-sitter-c-sharp",
                "output": "wasm"
              },
              {
                "glob": "web-tree-sitter.wasm",
                "input": "node_modules/web-tree-sitter",
                "output": "wasm"
              }
            ],
            "styles": ["node_modules/@foblex/flow/styles/default.scss", "src/styles.scss"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.1MB",
                  "maximumError": "1.3MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "12kB"
                }
              ],
              "outputHashing": "all"
            },
            "embedded": {
              "outputPath": { "base": "dist/embedded", "browser": "" },
              "baseHref": "./",
              "outputHashing": "none",
              "optimization": {
                "scripts": true,
                "styles": { "minify": true, "inlineCritical": false },
                "fonts": false
              },
              "fileReplacements": [
                {
                  "replace": "src/app/app.config.ts",
                  "with": "src/app/app.config.embedded.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "ariadne:build:production"
            },
            "development": {
              "buildTarget": "ariadne:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "exclude": ["src/**/*.perf.spec.ts"]
          },
          "configurations": {
            "perf": {
              "include": ["src/**/*.perf.spec.ts"],
              "exclude": [],
              "reporters": ["verbose"]
            },
            "ci": {
              "reporters": ["default", ["junit", { "outputFile": "../../test-results/junit.xml" }]]
            }
          }
        }
      }
    }
  }
}
