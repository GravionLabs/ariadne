{
  "name": "@ariadne/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --no-watch",
    "perf": "ng test --no-watch --configuration=perf",
    "build:embedded": "ng build --configuration production,embedded",
    "capture": "ng build && playwright test --config capture/playwright.config.ts",
    "capture:install": "playwright install --with-deps chromium",
    "test:ci": "ng test --no-watch --configuration=ci",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@ariadne/core": "workspace:*",
    "@ariadne/editor-protocol": "workspace:*",
    "@ariadne/export": "workspace:*",
    "@ariadne/masstransit": "workspace:*",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@dagrejs/dagre": "^3.1.1",
    "@foblex/2d": "^1.2.2",
    "@foblex/flow": "^19.3.0",
    "@foblex/mediator": "^1.1.3",
    "@foblex/platform": "^1.0.4",
    "@foblex/utils": "^1.1.1",
    "@lezer/highlight": "^1.2.5",
    "@ngrx/signals": "^22.0.1",
    "rxjs": "~7.8.0",
    "tree-sitter-c-sharp": "^0.23.5",
    "tslib": "^2.3.0",
    "web-tree-sitter": "^0.27.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@playwright/test": "^1.63.0",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.0",
    "markdown-it": "^15.0.2",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
