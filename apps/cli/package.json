{
  "name": "@ariadne/cli",
  "version": "0.0.0",
  "private": true,
  "description": "The ariadne command: lint, export, and convert saga diagrams to and from C#, locally and in CI.",
  "type": "module",
  "bin": {
    "ariadne": "./dist/ariadne.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "perf": "vitest run --config vitest.perf.config.ts",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile.junit=../../test-results/junit-cli.xml"
  },
  "dependencies": {
    "@ariadne/core": "workspace:*",
    "@ariadne/export": "workspace:*",
    "@ariadne/masstransit": "workspace:*",
    "@dagrejs/dagre": "^3.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "tree-sitter-c-sharp": "^0.23.5",
    "web-tree-sitter": "^0.27.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "dejavu-fonts-ttf": "^2.37.3",
    "esbuild": "^0.28.2",
    "vitest": "^5.0.0"
  }
}
