{
  "name": "ariadne-vscode",
  "displayName": "Ariadne",
  "version": "0.0.0",
  "private": true,
  "description": "Edit MassTransit saga diagrams (*.saga.yaml) next to the code.",
  "publisher": "gravionlabs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GravionLabs/ariadne.git",
    "directory": "apps/vscode"
  },
  "bugs": {
    "url": "https://github.com/GravionLabs/ariadne/issues"
  },
  "homepage": "https://github.com/GravionLabs/ariadne/tree/main/apps/vscode#readme",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#6366f1",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=22"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "saga",
    "state machine",
    "masstransit",
    "diagram",
    "c#",
    "yaml",
    "mermaid",
    "documentation"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.saga.yaml",
    "workspaceContains:**/*.cs",
    "onLanguage:csharp"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "ariadne.sagaEditor",
        "displayName": "Ariadne Saga Diagram",
        "selector": [
          {
            "filenamePattern": "*.saga.yaml"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "ariadne.newDiagram",
        "title": "New Saga Diagram",
        "category": "Ariadne"
      },
      {
        "command": "ariadne.showAsText",
        "title": "Show Saga Diagram as Text",
        "category": "Ariadne",
        "icon": "$(go-to-file)"
      },
      {
        "command": "ariadne.openDiagram",
        "title": "Open Saga Diagram",
        "category": "Ariadne",
        "icon": "$(preview)"
      },
      {
        "command": "ariadne.importFromCsharp",
        "title": "Import Saga from C#…",
        "category": "Ariadne",
        "icon": "$(arrow-right)"
      },
      {
        "command": "ariadne.generateCsharp",
        "title": "Generate C#",
        "category": "Ariadne",
        "icon": "$(file-code)"
      },
      {
        "command": "ariadne.updateDiagramFromCode",
        "title": "Update Diagram from Code",
        "category": "Ariadne"
      },
      {
        "command": "ariadne.openDriftDiff",
        "title": "Compare Diagram with Code",
        "category": "Ariadne"
      },
      {
        "command": "ariadne.export",
        "title": "Export Diagram…",
        "category": "Ariadne",
        "icon": "$(export)"
      },
      {
        "command": "ariadne.exportMermaid",
        "title": "Export as Mermaid",
        "category": "Ariadne"
      },
      {
        "command": "ariadne.exportSvg",
        "title": "Export as SVG",
        "category": "Ariadne"
      },
      {
        "command": "ariadne.exportPng",
        "title": "Export as PNG",
        "category": "Ariadne"
      },
      {
        "command": "ariadne.exportMarkdown",
        "title": "Export as Markdown",
        "category": "Ariadne"
      },
      {
        "command": "ariadne.copyMermaid",
        "title": "Copy as Mermaid",
        "category": "Ariadne"
      },
      {
        "command": "ariadne.copyMarkdown",
        "title": "Copy as Markdown",
        "category": "Ariadne"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "ariadne.showAsText",
          "when": "activeCustomEditorId == ariadne.sagaEditor"
        },
        {
          "command": "ariadne.openDiagram",
          "when": "resourceFilename =~ /\\.saga\\.yaml$/ && activeCustomEditorId != ariadne.sagaEditor"
        },
        {
          "command": "ariadne.generateCsharp",
          "when": "activeCustomEditorId == ariadne.sagaEditor || resourceFilename =~ /\\.saga\\.yaml$/"
        },
        {
          "command": "ariadne.updateDiagramFromCode",
          "when": "false"
        },
        {
          "command": "ariadne.openDriftDiff",
          "when": "false"
        },
        {
          "command": "ariadne.export",
          "when": "activeCustomEditorId == ariadne.sagaEditor || resourceFilename =~ /\\.saga\\.yaml$/"
        },
        {
          "command": "ariadne.exportMermaid",
          "when": "activeCustomEditorId == ariadne.sagaEditor || resourceFilename =~ /\\.saga\\.yaml$/"
        },
        {
          "command": "ariadne.exportSvg",
          "when": "activeCustomEditorId == ariadne.sagaEditor || resourceFilename =~ /\\.saga\\.yaml$/"
        },
        {
          "command": "ariadne.exportPng",
          "when": "activeCustomEditorId == ariadne.sagaEditor || resourceFilename =~ /\\.saga\\.yaml$/"
        },
        {
          "command": "ariadne.exportMarkdown",
          "when": "activeCustomEditorId == ariadne.sagaEditor || resourceFilename =~ /\\.saga\\.yaml$/"
        },
        {
          "command": "ariadne.copyMermaid",
          "when": "activeCustomEditorId == ariadne.sagaEditor || resourceFilename =~ /\\.saga\\.yaml$/"
        },
        {
          "command": "ariadne.copyMarkdown",
          "when": "activeCustomEditorId == ariadne.sagaEditor || resourceFilename =~ /\\.saga\\.yaml$/"
        }
      ],
      "editor/title": [
        {
          "command": "ariadne.showAsText",
          "when": "activeCustomEditorId == ariadne.sagaEditor",
          "group": "navigation"
        },
        {
          "command": "ariadne.openDiagram",
          "when": "resourceFilename =~ /\\.saga\\.yaml$/ && activeCustomEditorId != ariadne.sagaEditor",
          "group": "navigation"
        },
        {
          "command": "ariadne.generateCsharp",
          "when": "activeCustomEditorId == ariadne.sagaEditor",
          "group": "navigation"
        },
        {
          "command": "ariadne.export",
          "when": "activeCustomEditorId == ariadne.sagaEditor",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "ariadne.newDiagram",
          "when": "explorerResourceIsFolder",
          "group": "navigation"
        },
        {
          "command": "ariadne.importFromCsharp",
          "when": "resourceExtname == .cs",
          "group": "navigation"
        },
        {
          "command": "ariadne.generateCsharp",
          "when": "resourceFilename =~ /\\.saga\\.yaml$/",
          "group": "navigation"
        },
        {
          "command": "ariadne.export",
          "when": "resourceFilename =~ /\\.saga\\.yaml$/",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "ariadne.importFromCsharp",
          "when": "resourceExtname == .cs",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Ariadne",
      "properties": {
        "ariadne.editor.defaultToDiagram": {
          "type": "boolean",
          "default": true,
          "description": "Open *.saga.yaml files as a diagram. When off, they open as text; use \"Open Saga Diagram\" to see the diagram."
        },
        "ariadne.editor.autoLayout": {
          "type": "boolean",
          "default": true,
          "description": "Arrange new diagram elements automatically."
        },
        "ariadne.import.folder": {
          "type": "string",
          "default": "",
          "description": "Folder for diagrams imported from C#, relative to the workspace folder. Empty: next to the C# file.",
          "scope": "resource"
        },
        "ariadne.generate.folder": {
          "type": "string",
          "default": "",
          "description": "Folder for generated C#, relative to the workspace folder. Empty: next to the C# file named in the diagram (saga.source), else next to the diagram.",
          "scope": "resource"
        },
        "ariadne.generate.namespace": {
          "type": "string",
          "default": "",
          "description": "Namespace for generated C# when the diagram does not name one (saga.namespace).",
          "scope": "resource"
        },
        "ariadne.drift.enabled": {
          "type": "boolean",
          "default": true,
          "description": "On save, compare a diagram with the C# file it names (saga.source) and report differences in the Problems panel.",
          "scope": "resource"
        },
        "ariadne.export.folder": {
          "type": "string",
          "default": "",
          "description": "Folder for exported files (SVG, PNG, Mermaid, Markdown), relative to the workspace folder. Empty: next to the diagram.",
          "scope": "resource"
        }
      }
    },
    "yamlValidation": [
      {
        "fileMatch": "*.saga.yaml",
        "url": "./dist/saga.schema.json"
      }
    ],
    "markdown.markdownItPlugins": true
  },
  "scripts": {
    "build": "pnpm --filter @ariadne/web build:embedded && node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile.junit=../../test-results/junit-vscode.xml",
    "test:integration": "pnpm build && node -e \"require('node:fs').rmSync('dist-test',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node dist-test/run-tests.js",
    "test:integration:ci": "xvfb-run -a pnpm test:integration",
    "dev": "pnpm build && node scripts/dev.mjs",
    "package": "node scripts/package.mjs",
    "test:vsix": "node -e \"require('node:fs').rmSync('dist-test',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node scripts/test-vsix.mjs",
    "test:vsix:ci": "xvfb-run -a pnpm test:vsix",
    "icon": "node scripts/icon.mjs",
    "package:test": "pnpm package && pnpm test:vsix"
  },
  "dependencies": {
    "@ariadne/core": "workspace:*",
    "@ariadne/editor-protocol": "workspace:*",
    "@ariadne/export": "workspace:*",
    "@ariadne/masstransit": "workspace:*",
    "@resvg/resvg-wasm": "^2.6.2",
    "tree-sitter-c-sharp": "^0.23.5",
    "web-tree-sitter": "^0.27.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.1",
    "@types/vscode": "^1.96.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.0.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "esbuild": "^0.28.2",
    "markdown-it": "^15.0.2",
    "mocha": "^11.7.0",
    "vitest": "^5.0.0"
  }
}
