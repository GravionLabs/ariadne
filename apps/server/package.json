{
  "name": "@ariadne/server",
  "version": "0.0.0",
  "private": true,
  "description": "Serves the built Ariadne web app for self-hosting: static files, /config.json and /health.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "node dist/server.mjs",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile.junit=../../test-results/junit-server.xml",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "hono": "^4.13.18"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "vitest": "^5.1.0"
  }
}
